{
  "name": "acpilot",
  "displayName": "ACPilot",
  "description": "A chat interface for ACP coding agents in VS Code and Cursor (Grok, Devin, Kimi Code)",
  "version": "1.0.0",
  "publisher": "hotic",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotic/acpilot.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "acpilot",
          "title": "ACPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "acpilot": [
        {
          "type": "webview",
          "id": "acpilot.chat",
          "name": "ACPilot",
          "icon": "media/icon.svg",
          "contextualTitle": "ACPilot"
        }
      ]
    },
    "commands": [
      {
        "command": "acpilot.newSession",
        "title": "%acpilot.cmd.newSession%",
        "category": "ACPilot",
        "icon": "$(add)"
      },
      {
        "command": "acpilot.openInEditor",
        "title": "%acpilot.cmd.openInEditor%",
        "category": "ACPilot",
        "icon": "$(open-preview)"
      },
      {
        "command": "acpilot.showLog",
        "title": "%acpilot.cmd.showLog%",
        "category": "ACPilot"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "acpilot.newSession",
          "when": "view == acpilot.chat",
          "group": "navigation@1"
        },
        {
          "command": "acpilot.openInEditor",
          "when": "view == acpilot.chat",
          "group": "navigation@2"
        },
        {
          "command": "acpilot.showLog",
          "when": "view == acpilot.chat"
        }
      ]
    },
    "configuration": {
      "title": "ACPilot",
      "properties": {
        "acpilot.defaultAgent": {
          "type": "string",
          "default": "grok",
          "description": "%acpilot.conf.defaultAgent%"
        },
        "acpilot.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "description": "%acpilot.conf.language%"
        },
        "acpilot.followUp": {
          "type": "string",
          "enum": [
            "queue",
            "steer",
            "interrupt"
          ],
          "default": "queue",
          "description": "%acpilot.conf.followUp%"
        },
        "acpilot.mcpServers": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "%acpilot.conf.mcpServers%",
          "additionalProperties": {
            "type": "object"
          }
        },
        "acpilot.agents": {
          "type": "object",
          "default": {},
          "markdownDescription": "%acpilot.conf.agents%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "login": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "acpilot.compactAtTokens": {
          "type": "number",
          "default": 300000,
          "description": "%acpilot.conf.compactAtTokens%"
        },
        "acpilot.autoCompact": {
          "type": "boolean",
          "default": true,
          "description": "%acpilot.conf.autoCompact%"
        },
        "acpilot.hiddenOptions": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "%acpilot.conf.hiddenOptions%",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "acpilot.appearance.density": {
          "type": "string",
          "enum": [
            "cozy",
            "compact",
            "airy"
          ],
          "default": "airy",
          "description": "%acpilot.conf.appearance.density%"
        },
        "acpilot.appearance.radius": {
          "type": "string",
          "enum": [
            "12",
            "8",
            "16"
          ],
          "default": "12",
          "description": "%acpilot.conf.appearance.radius%"
        },
        "acpilot.appearance.surface": {
          "type": "string",
          "enum": [
            "hairline",
            "tonal",
            "stroke"
          ],
          "default": "tonal",
          "description": "%acpilot.conf.appearance.surface%"
        },
        "acpilot.appearance.font": {
          "type": "string",
          "enum": [
            "system",
            "inter",
            "geist"
          ],
          "default": "inter",
          "description": "%acpilot.conf.appearance.font%"
        },
        "acpilot.appearance.userMessage": {
          "type": "string",
          "enum": [
            "bubble",
            "block",
            "plain"
          ],
          "default": "block",
          "description": "%acpilot.conf.appearance.userMessage%"
        },
        "acpilot.appearance.toolLine": {
          "type": "string",
          "enum": [
            "text",
            "icon",
            "rich"
          ],
          "default": "icon",
          "description": "%acpilot.conf.appearance.toolLine%"
        },
        "acpilot.appearance.thought": {
          "type": "string",
          "enum": [
            "text",
            "shimmer",
            "orb"
          ],
          "default": "orb",
          "description": "%acpilot.conf.appearance.thought%"
        },
        "acpilot.appearance.sessions": {
          "type": "string",
          "enum": [
            "dropdown",
            "drawer"
          ],
          "default": "dropdown",
          "description": "%acpilot.conf.appearance.sessions%"
        },
        "acpilot.appearance.composer": {
          "type": "string",
          "enum": [
            "island",
            "flush"
          ],
          "default": "island",
          "description": "%acpilot.conf.appearance.composer%"
        },
        "acpilot.appearance.beam": {
          "type": "string",
          "enum": [
            "line",
            "none",
            "pulse",
            "full"
          ],
          "default": "full",
          "description": "%acpilot.conf.appearance.beam%"
        },
        "acpilot.appearance.beamColor": {
          "type": "string",
          "enum": [
            "mono",
            "ocean",
            "colorful"
          ],
          "default": "mono",
          "description": "%acpilot.conf.appearance.beamColor%"
        },
        "acpilot.appearance.send": {
          "type": "string",
          "enum": [
            "accent",
            "icon",
            "metal"
          ],
          "default": "metal",
          "description": "%acpilot.conf.appearance.send%"
        },
        "acpilot.appearance.accent": {
          "type": "string",
          "enum": [
            "brand",
            "agent",
            "vscode"
          ],
          "default": "agent",
          "description": "%acpilot.conf.appearance.accent%"
        },
        "acpilot.appearance.motion": {
          "type": "string",
          "enum": [
            "subtle",
            "none",
            "full"
          ],
          "default": "subtle",
          "description": "%acpilot.conf.appearance.motion%"
        },
        "acpilot.appearance.fold": {
          "type": "string",
          "enum": [
            "codex",
            "cursor"
          ],
          "default": "codex",
          "description": "%acpilot.conf.appearance.fold%"
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:host": "node esbuild.host.mjs",
    "build": "pnpm build:host && pnpm build:webview",
    "watch:host": "node esbuild.host.mjs --watch",
    "watch:webview": "vite build --config vite.webview.config.ts --watch",
    "dev": "pnpm build && (pnpm watch:host & pnpm watch:webview & wait)",
    "typecheck": "tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "test": "vitest run",
    "probe": "tsx scripts/acp-probe.ts",
    "package": "pnpm build && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "border-beam": "1.3.0",
    "clsx": "2.1.1",
    "katex": "0.16.47",
    "lucide-react": "1.35.0",
    "metal-fx": "1.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.8.0",
    "streamdown": "2.6.0",
    "thinking-orbs": "0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/vscode": "1.125.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@vscode/vsce-sign",
      "keytar"
    ]
  }
}
